{
  "contractVersion": "2.6.0",
  "serverVersion": "0.4.0-rc.1",
  "transport": "stdio+loopback_websocket",
  "protocolVersion": "3",
  "principles": {
    "agentUpdateRequiresUserApproval": true,
    "allNewCollectionRequiresScopedAuthorization": true,
    "collectionAuthorizationStaysInAgent": true,
    "pairingIsOnlyExtensionUserAction": true,
    "ordinaryExplicitScopeRequestMayAuthorizeCollection": true,
    "conversationRelayIsNotIndependentUserEventProof": true,
    "bareApproveOnlyRequestsUserConfirmation": true,
    "collectionDefaultsAreProposalsNotAuthorization": true,
    "collectionPlansAreFrozenOwnedExpiringAndOneTime": true,
    "rejectedOrReplacedPlansCannotExecute": true,
    "readOnlyAssetsDoNotRequireCollectionConsent": true,
    "currentTaskExplicitScopeApprovalIsReusable": true,
    "collectionApprovalDoesNotRequireExactWording": true,
    "multipleCollectionPlansMayShareOneApproval": true,
    "extensionOwnsAuthorizationAndExecution": true,
    "agentNeverParsesPlatformPages": true,
    "authorizedCapabilitiesReturnCompleteStoredRecords": true,
    "basicListCaptureNeverImplicitlyEnhances": true,
    "profileCollectionRequiresExplicitIntentPlan": true,
    "profileCollectionUsesPurposeDrivenRecommendations": true,
    "analysisReusesExistingReportBeforeRawCapture": true,
    "analysisReusesExistingCaptureBeforeNewCollection": true,
    "accountAnalysisUsesWorkbenchEvidenceContract": true,
    "singleNoteAnalysisUsesWorkbenchEvidenceContract": true,
    "profileCollectionPlanRequiresOneTimeConfirmation": true,
    "fullArchiveIsFirstClassProfilePurpose": true,
    "fullArchiveReturnsPreviewAndDataPoolPointer": true,
    "archiveItemFailuresDoNotAbortRemainingRecords": true,
    "archiveRetriesOnlyRecoverableCaptureFailures": true,
    "confirmedProfilePlanMayCrossRecommendedContinuousBoundary": true,
    "profileRiskUsesNormalYellowRedTiers": true,
    "profileRetryPolicyIsNotARiskTrigger": true,
    "profileExecutionInterruptionsReturnRecoveryAction": true,
    "captureRiskNeverSilentlyTruncatesRequestedScope": true,
    "largeResultsUseChunkedExtensionTransport": true,
    "videoTranscriptRequiresOneTimeQuote": true,
    "destructiveDataClearRequiresPreviewToken": true,
    "commentOutreachRequiresReviewedConversationApproval": true,
    "commentOutreachConfirmationBoundToAgentSession": true,
    "videoTranscriptSupportsLocalExecution": false,
    "byokSupported": false
  },
  "responseConventions": {
    "agentUpdateField": "agentUpdate",
    "synchronous": "MCP tool result contains task plus result",
    "asynchronous": "async=true returns a task handle",
    "persistentRecordKey": "assetId or recordId",
    "limitationsField": "limitations",
    "recoverableInterruptionField": "nextAction",
    "paywallField": "paywall",
    "transcriptConfirmationField": "quoteId",
    "collectionPreparation": "Returns confirmation_required and collectionStarted=false; no browser task",
    "collectionConfirmation": "mediaclaw_confirm_collection accepts scoped conversation authorization (ordinary explicit user_request or post-preview user_reply) or requests native client elicitation; bare approve never starts collection; unsupported hosts ask in the current conversation, never the extension; one authorization covers declared groups and retries"
  },
  "tools": [
    {"name": "mediaclaw_get_capabilities", "kind": "control", "stability": "stable", "readOnly": true},
    {"name": "mediaclaw_prepare_collection", "kind": "plan", "stability": "stable", "startsCollection": false, "confirmationField": "planId"},
    {"name": "mediaclaw_confirm_collection", "kind": "workflow", "stability": "stable", "requiresUserApproval": true, "confirmationArgument": "planId", "batchConfirmationArgument": "planIds"},
    {"name": "mediaclaw_connection_status", "kind": "control", "stability": "stable"},
    {"name": "mediaclaw_manage_agent_update", "kind": "control", "stability": "stable", "requiresUserApproval": true},
    {"name": "mediaclaw_list_paired_devices", "kind": "control", "stability": "stable"},
    {"name": "mediaclaw_list_assets", "kind": "asset", "stability": "stable"},
    {"name": "mediaclaw_get_asset", "kind": "asset", "stability": "stable"},
    {"name": "mediaclaw_get_video_transcript", "kind": "asset", "stability": "stable"},
    {"name": "mediaclaw_capture_note", "requiresCollectionPlan": true, "startsCollection": false, "kind": "capture", "stability": "stable"},
    {"name": "mediaclaw_capture_search_basic", "requiresCollectionPlan": true, "startsCollection": false, "kind": "capture", "stability": "stable"},
    {"name": "mediaclaw_capture_profile_basic", "requiresCollectionPlan": true, "startsCollection": false, "kind": "capture", "stability": "stable"},
    {"name": "mediaclaw_prepare_profile_collection", "kind": "plan", "stability": "stable", "startsCollection": false, "confirmationField": "planId"},
    {"name": "mediaclaw_confirm_profile_collection", "kind": "workflow", "stability": "stable", "requiresUserApproval": true, "confirmationArgument": "planId"},
    {"name": "mediaclaw_enhance_records", "requiresCollectionPlan": true, "startsCollection": false, "kind": "capture", "stability": "stable", "requiresCredential": true, "confirmationArgument": "planId"},
    {"name": "mediaclaw_capture_comments", "requiresCollectionPlan": true, "startsCollection": false, "kind": "capture", "stability": "stable"},
    {"name": "mediaclaw_list_comment_outreach_candidates", "kind": "outreach", "stability": "stable", "externalWrite": false},
    {"name": "mediaclaw_prepare_comment_outreach", "kind": "outreach", "stability": "stable", "startsSending": false, "requiresReviewedConversationApproval": true},
    {"name": "mediaclaw_set_comment_outreach_enabled", "kind": "control", "stability": "stable", "startsSending": false, "requiresUserRequest": true},
    {"name": "mediaclaw_confirm_comment_outreach", "kind": "outreach", "stability": "stable", "externalWrite": true, "requiresReviewedConversationApproval": true, "confirmationArgument": "confirmationToken"},
    {"name": "mediaclaw_cancel_comment_outreach", "kind": "outreach", "stability": "stable", "startsSending": false, "requiresUserRequest": true},
    {"name": "mediaclaw_get_comment_outreach_status", "kind": "outreach", "stability": "stable", "externalWrite": false},
    {"name": "mediaclaw_preview_clear_data", "kind": "control", "stability": "stable"},
    {"name": "mediaclaw_confirm_clear_data", "kind": "control", "stability": "stable", "confirmationArgument": "confirmationToken"},
    {"name": "mediaclaw_extract_image_text", "requiresCollectionPlan": true, "startsCollection": false, "kind": "extract", "stability": "stable", "requiresCredential": true},
    {"name": "mediaclaw_quote_video_transcript", "kind": "quote", "stability": "stable", "requiresCredential": true},
    {"name": "mediaclaw_confirm_video_transcript", "kind": "extract", "stability": "stable", "requiresCredential": true, "metered": true, "confirmationArgument": "quoteId"},
    {"name": "mediaclaw_task_status", "kind": "control", "stability": "stable"},
    {"name": "mediaclaw_cancel_task", "kind": "control", "stability": "stable"},
    {"name": "mediaclaw_scan_keyword", "requiresCollectionPlan": true, "startsCollection": false, "kind": "legacy", "stability": "deprecated"},
    {"name": "mediaclaw_expand_keywords", "requiresCollectionPlan": true, "startsCollection": false, "kind": "legacy", "stability": "deprecated"},
    {"name": "mediaclaw_research_keyword_topics", "requiresCollectionPlan": true, "startsCollection": false, "kind": "workflow", "stability": "deprecated", "methodId": "keyword-topic-trends-v1", "methodVersion": "2.0.0"},
    {"name": "mediaclaw_research_longtail_keywords", "requiresCollectionPlan": true, "startsCollection": false, "kind": "workflow", "stability": "deprecated", "methodId": "keyword-longtail-demand-v1", "methodVersion": "2.0.0"},
    {"name": "mediaclaw_scan_account", "requiresCollectionPlan": true, "startsCollection": false, "kind": "legacy", "stability": "deprecated"},
    {"name": "mediaclaw_capture_account_profile", "requiresCollectionPlan": true, "startsCollection": false, "kind": "legacy", "stability": "deprecated"},
    {"name": "mediaclaw_research_account_hits", "requiresCollectionPlan": true, "startsCollection": false, "kind": "workflow", "stability": "deprecated", "methodId": "account-recent-hits-v1", "methodVersion": "2.0.0"},
    {"name": "mediaclaw_research_benchmark_accounts", "requiresCollectionPlan": true, "startsCollection": false, "kind": "workflow", "stability": "deprecated", "methodId": "benchmark-account-discovery-v1", "methodVersion": "2.0.0"},
    {"name": "mediaclaw_list_style_profiles", "kind": "legacy", "stability": "deprecated"},
    {"name": "mediaclaw_get_style_profile", "kind": "legacy", "stability": "deprecated"},
    {"name": "mediaclaw_capture_content", "requiresCollectionPlan": true, "startsCollection": false, "kind": "legacy", "stability": "deprecated"},
    {"name": "mediaclaw_research_single_note", "requiresCollectionPlan": true, "startsCollection": false, "kind": "workflow", "stability": "deprecated", "methodId": "single-note-breakdown-v1", "methodVersion": "3.0.0"},
    {"name": "mediaclaw_deep_collect", "requiresCollectionPlan": true, "startsCollection": false, "kind": "legacy", "stability": "deprecated"},
    {"name": "mediaclaw_capture_comments_full", "requiresCollectionPlan": true, "startsCollection": false, "kind": "legacy", "stability": "deprecated"},
    {"name": "mediaclaw_query_data_pool", "kind": "legacy", "stability": "deprecated"},
    {"name": "mediaclaw_get_data_pool_record", "kind": "legacy", "stability": "deprecated"},
    {"name": "mediaclaw_query_dataset", "kind": "legacy", "stability": "deprecated"}
  ]
}
