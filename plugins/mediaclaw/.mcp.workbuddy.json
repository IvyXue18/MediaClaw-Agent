{
  "mcpServers": {
    "mediaclaw": {
      "command": "/bin/bash",
      "args": [
        "-lc",
        "plugin_root=\"${CODEBUDDY_PLUGIN_ROOT:-$PWD}\"; exec node \"$plugin_root/scripts/mcp-server.mjs\""
      ],
      "cwd": ".",
      "env": {
        "MEDIACLAW_AGENT_HOST": "workbuddy",
        "MEDIACLAW_AGENT_DEVICE_NAME": "MediaClaw Agent (WorkBuddy)"
      }
    }
  }
}
